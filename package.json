{
  "name": "@vennahlot/dsh-tabs",
  "version": "0.1.2",
  "description": "Chrome-style tabs for DSH chat sessions: a vertical or horizontal tab strip in your order, collapsible tab groups, each tab one session or a split of up to four live panes.",
  "license": "MIT",
  "author": "Yichen Wang",
  "homepage": "https://github.com/vennahlot/dsh-tabs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vennahlot/dsh-tabs.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "tabs"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/moves.test.mjs",
    "check": "node --check client.js && node --check index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "icon": "./icon.svg",
  "publishConfig": {
    "access": "public"
  }
}
